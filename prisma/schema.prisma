// Branch and lower models - Church relation points to Organization
model Branch {
  id              String      @id @default(auto()) 
  churchId        String      @id
  church          Organization @relation(fields: [churchId], references: [id]) // CRITICAL: Organization
  branchName      String      @unique
  email           String?
  phoneNumber     String?
  capacity        Int
  members         Int         @default(0)
  establishedDate DateTime
  description     String?
  isActive        Boolean     @default(true)
  isDeleted       Boolean     @default(false)
  // Relations
  pastorId        String?     @id
  pastor          User?       @relation("BranchPastor", fields: [pastorId], references: [id])
  users           Member[]    @relation("BranchMembers") // CRITICAL: Use Member model for branch members
  serviceSchedules ServiceSchedule[]
  prayerRequests  PrayerRequest[]
  activities      Activity[]
  assets          Asset[]
  addresses       Address[]
  announcements   Announcement[]
  attendances     Attendance[]
  events          Event[]
  reports         Report[]
  milestones      Milestone[]
  offerings       Offering[]
  disciples       Disciple[]
  pledges         Pledge[]
  discipleProgress DiscipleProgress[]
  content         Content[]
  messageRecipients MessageRecipient[]
  messages        Message[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([churchId, isActive])
  @@index([churchId, isDeleted])
  @@index([pastorId])
