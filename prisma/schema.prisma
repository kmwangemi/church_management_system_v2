  servicesAttended        String[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  invitedBy               String?
  userId                  String         @unique
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("visitor_details")
}

// ============================================
// BRANCH AND ORGANIZATIONAL STRUCTURE
// ============================================

model Branch {
  id              String       @id @default(cuid())
  branchName      String       @unique
  email           String?
  phoneNumber     String?
  capacity        Int
  members         Int          @default(0)
  establishedDate DateTime
  description     String?
  isActive        Boolean      @default(true)
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  churchId        String
  church          Organization @relation(fields: [churchId], references: [id])
  pastorId        String?
  pastor          User?        @relation("BranchPastor", fields: [pastorId], references: [id])
  // Relations
  users               Member[]            @relation("BranchMembers")
  serviceSchedules    ServiceSchedule[]
  prayerRequests      PrayerRequest[]
  activities          Activity[]
  assets              Asset[]
  address             Address[]
  announcements       Announcement[]
  attendances         Attendance[]
  events              Event[]
  reports             Report[]
  milestones          Milestone[]
  offerings           Offering[]
  disciples           Disciple[]
  pledges             Pledge[]
  discipleProgress    DiscipleProgress[]
  content             Content[]
  messageRecipients   MessageRecipient[]
  messages            Message[]
  @@index([churchId, isActive])
  @@index([churchId, isDeleted])
  @@index([pastorId])
  @@map("branch")
}

model Department {
  id              String               @id @default(cuid())
  departmentName  String
  description     String
  location        String?
  category        DepartmentCategory
  establishedDate DateTime
  meetingDay      String[]
  meetingTime     String[]
  isActive        Boolean              @default(true)
  isDeleted       Boolean              @default(false)
  totalBudget     Float                @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  churchId        String
  church          Organization         @relation(fields: [churchId], references: [id])
  branchId        String?
  leaderId        String?
  leader          User?                @relation("DepartmentLeader", fields: [leaderId], references: [id])
  // Relations
  members         DepartmentMember[]
  budgetCategories BudgetCategory[]
  expenses        Expense[]
  activities      DepartmentActivity[]
  goals           DepartmentGoal[]
  @@index([churchId])
  @@index([leaderId])
  @@map("department")
}

model DepartmentMember {
  id           String     @id @default(cuid())
  role         MemberRole
  skills       String[]
  joinedDate   DateTime   @default(now())
  isActive     Boolean    @default(true)
  notes        String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  @@map("department_member")
}

model BudgetCategory {
  id              String          @id @default(cuid())
  category        ExpenseCategory
  allocatedAmount Float
  spentAmount     Float           @default(0)
  description     String?
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  @@map("budget_category")
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  amount       Float
  description  String
  date         DateTime
  reference    String?
  vendor       String?
  receiptUrl   String?
  createdAt    DateTime        @default(now())
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  approvedBy   String?
  approver     User?           @relation(fields: [approvedBy], references: [id])
  @@map("expense")
}

model DepartmentActivity {
  id           String       @id @default(cuid())
  title        String
  description  String
  type         ActivityType
  date         DateTime
  startTime    String?
  endTime      String?
  location     String?
  participants String[]
  notes        String?
  isCompleted  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  organizedBy  String
  organizer    User         @relation(fields: [organizedBy], references: [id])
  @@map("department_activity")
}

model DepartmentGoal {
  id           String     @id @default(cuid())
  title        String
  description  String
  targetDate   DateTime
  status       GoalStatus @default(PLANNED)
  priority     String
  category     String
  success      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  assignee     String?
  createdBy    String
  creator      User       @relation(fields: [createdBy], references: [id])
  @@map("department_goal")
}

model Group {
  id                String              @id @default(cuid())
  groupName         String
  description       String?
  category          GroupCategory
  meetingDay        String[]
  meetingTime       String[]
  location          String?
  establishedDate   DateTime
  capacity          Int
  isActive          Boolean             @default(true)
  totalMembers      Int                 @default(0)
  activeMembers     Int                 @default(0)
  averageAttendance Float               @default(0)
  totalActivities   Int                 @default(0)
  completedGoals    Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  churchId          String
  church            Organization        @relation(fields: [churchId], references: [id])
  leaderId          String?
  leader            User?               @relation("GroupLeader", fields: [leaderId], references: [id])
  // Relations
  members           GroupMember[]
  activities        GroupActivity[]
  goals             GroupGoal[]
  attendanceSummaries AttendanceSummary[]
  @@index([churchId])
  @@index([leaderId])
  @@index([category])
  @@map("group")
}

model GroupMember {
  id          String     @id @default(cuid())
  role        MemberRole
  joinedDate  DateTime   @default(now())
  isActive    Boolean    @default(true)
  notes       String?
  phone       String?
  email       String?
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  @@map("group_member")
}

model GroupActivity {
  id           String             @id @default(cuid())
  title        String
  description  String
  type         GroupActivityType
  date         DateTime
  startTime    String?
  endTime      String?
  location     String?
  participants String[]
  notes        String?
  isCompleted  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  groupId      String
  group        Group              @relation(fields: [groupId], references: [id])
  organizedBy  String
  organizer    User               @relation(fields: [organizedBy], references: [id])
  attendance   AttendanceRecord[]
  @@map("group_activity")
}

model GroupGoal {
  id          String          @id @default(cuid())
  title       String
  description String
  targetDate  DateTime
  status      GroupGoalStatus @default(PLANNED)
  priority    String
  category    String
  success     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  groupId     String
  group       Group           @relation(fields: [groupId], references: [id])
  assignee    String?
  createdBy   String
  creator     User            @relation(fields: [createdBy], references: [id])
  @@map("group_goal")
}

model AttendanceSummary {
  id             String             @id @default(cuid())
  date           DateTime
  totalExpected  Int
  totalPresent   Int
  totalAbsent    Int
  totalLate      Int                @default(0)
  attendanceRate Float
  groupId        String
  group          Group              @relation(fields: [groupId], references: [id])
  records        AttendanceRecord[]
  @@map("attendance_summary")
}

model AttendanceRecord {
  id                  String             @id @default(cuid())
  status              AttendanceStatus
  arrivalTime         DateTime?
  notes               String?
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  groupActivityId     String?
  groupActivity       GroupActivity?     @relation(fields: [groupActivityId], references: [id])
  attendanceSummaryId String?
  attendanceSummary   AttendanceSummary? @relation(fields: [attendanceSummaryId], references: [id])
  attendanceId        String?
  attendance          Attendance?        @relation(fields: [attendanceId], references: [id])
  @@map("attendance_record")
}

// ============================================
// EVENTS AND ACTIVITIES
// ============================================

model Event {
  id                   String      @id @default(cuid())
  title                String
  description          String
  type                 String
  startDate            DateTime
  endDate              DateTime
  startTime            String
  endTime              String
  location             String
  expectedAttendees    Int
  organizer            String
  maxAttendees         Int?
  requiresRegistration Boolean     @default(false)
  isRecurring          Boolean     @default(false)
  recurringPattern     String?
  registrationDeadline DateTime?
  notes                String?
  isPublic             Boolean     @default(true)
  status               EventStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  churchId             String
  church               Organization @relation(fields: [churchId], references: [id])
  branchId             String
  branch               Branch       @relation(fields: [branchId], references: [id])
  @@index([churchId, startDate])
  @@index([status])
  @@index([branchId])
  @@map("event")
}

model Activity {
  id           String           @id @default(cuid())
  date         DateTime
  activity     String
  participants Int
  type         ActivityTypeEnum @default(EVENT)
  status       ActivityStatus   @default(PLANNED)
  startTime    String?
  endTime      String?
  location     String?
  facilitator  String?
  budget       Float?
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  churchId     String
  church       Organization     @relation(fields: [churchId], references: [id])
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  @@index([churchId, branchId])
  @@index([churchId, date])
  @@index([date, status])
  @@map("activity")
}

// ============================================
// FINANCIAL MODELS
// ============================================

model Offering {
  id        String        @id @default(cuid())
  type      OfferingType
  amount    Float
  method    PaymentMethod
  date      DateTime
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  churchId  String
  church    Organization  @relation(fields: [churchId], references: [id])
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  memberId  String
  member    User          @relation(fields: [memberId], references: [id])
  @@index([churchId, date])
  @@index([memberId, date])
  @@map("offering")
}

model Pledge {
  id              String          @id @default(cuid())
  amount          Float
  paid            Float           @default(0)
  remaining       Float
  dueDate         DateTime
  purpose         PledgePurpose
  paymentSchedule PaymentSchedule @default(ONE_TIME)
  notes           String?
  status          PledgeStatus    @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  churchId        String
  church          Organization    @relation(fields: [churchId], references: [id])
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  memberId        String
  member          User            @relation(fields: [memberId], references: [id])
  @@index([churchId, status])
  @@index([memberId, status])
  @@index([dueDate, status])
  @@map("pledge")
}

// ============================================
// PRAYER AND SPIRITUAL
// ============================================

model PrayerRequest {
  id                String         @id @default(cuid())
  title             String
  description       String
  category          PrayerCategory
  priority          Priority       @default(MEDIUM)
  status            PrayerStatus   @default(ACTIVE)
  isAnonymous       Boolean        @default(false)
  isPublic          Boolean        @default(true)
  answeredDate      DateTime?
  answerDescription String?
  prayerCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  churchId          String
  church            Organization   @relation(fields: [churchId], references: [id])
  branchId          String
  branch            Branch         @relation(fields: [branchId], references: [id])
  memberId          String?
  submittedBy       String
  submitter         User           @relation("PrayerRequestSubmitter", fields: [submittedBy], references: [id])
  @@index([churchId, branchId])
  @@index([churchId, category])
  @@index([churchId, status])
  @@map("prayer_request")
}

// ============================================
// SCHEDULES AND ATTENDANCE
// ============================================

model ServiceSchedule {
  id          String       @id @default(cuid())
  day         DayOfWeek
  time        String
  service     String
  attendance  Int?
  type        ServiceType  @default(WORSHIP)
  duration    Int?         @default(90)
  facilitator String?
  location    String?
  recurring   Boolean      @default(true)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  churchId    String
  church      Organization @relation(fields: [churchId], references: [id])
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id])
  @@index([churchId, branchId])
  @@map("service_schedule")
}

model Attendance {
  id             String             @id @default(cuid())
  serviceDate    DateTime
  serviceType    ServiceType
  totalAttendees Int
  offeringAmount Float?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  churchId       String
  church         Organization       @relation(fields: [churchId], references: [id])
  branchId       String
  branch         Branch             @relation(fields: [branchId], references: [id])
  takenBy        String
  taker          User               @relation(fields: [takenBy], references: [id])
  records        AttendanceRecord[]
  @@index([churchId, serviceDate])
  @@map("attendance")
}

// ============================================
// ASSETS
// ============================================

model Asset {
  id                  String              @id @default(cuid())
  name                String
  type                AssetType
  description         String?
  category            String
  purchaseDate        DateTime?
  purchasePrice       Float?
  value               Float
  condition           AssetCondition
  status              AssetStatus         @default(ACTIVE)
  serialNumber        String?
  warranty            String?
  supplier            String?
  maintenanceSchedule MaintenanceSchedule?
  currentValue        Float?
  location            String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  churchId            String
  church              Organization        @relation(fields: [churchId], references: [id])
  branchId            String
  branch              Branch              @relation(fields: [branchId], references: [id])
  maintenanceRecords  MaintenanceRecord[]
  @@index([churchId, status])
  @@index([branchId])
  @@map("asset")
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  cost        Float?
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  @@map("maintenance_record")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id               String               @id @default(cuid())
  title            String
  content          String
  category         AnnouncementCategory
  priority         Priority             @default(MEDIUM)
  publishDate      DateTime
  expiryDate       DateTime?
  status           AnnouncementStatus   @default(DRAFT)
  viewCount        Int                  @default(0)
  targetAudience   String[]
  attachments      String[]
  isSticky         Boolean              @default(false)
  notificationSent Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  churchId         String
  church           Organization         @relation(fields: [churchId], references: [id])
  branchId         String?
  branch           Branch?              @relation(fields: [branchId], references: [id])
  authorId         String
  author           User                 @relation(fields: [authorId], references: [id])
  @@index([churchId, branchId])
  @@index([churchId, category])
  @@index([churchId, status])
  @@index([publishDate])
  @@map("announcement")
}

// ============================================
// SUBSCRIPTIONS
// ============================================

model ChurchSubscription {
  id                 String             @id @default(cuid())
  plan               ChurchPlan
  status             SubscriptionStatus @default(TRIAL)
  isPaid             Boolean            @default(false)
  isActive           Boolean            @default(false)
  invoiceAmount      Float              @default(0)
  paidAmount         Float              @default(0)
  balAmount          Float              @default(0)
  maxUsers           Int?
  maxBranches        Int?               @default(1)
  maxSmallGroups     Int?
  currentUsers       Int                @default(0)
  currentBranches    Int                @default(0)
  currentSmallGroups Int                @default(0)
  features           String[]
  startDate          DateTime
  endDate            DateTime
  isAutoRenew        Boolean            @default(true)
  paymentMethod      PaymentMethodType? @default(M_PESA)
  lastPaymentDate    DateTime?
  nextBillingDate    DateTime?
  canceledAt         DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  churchId           String             @unique
  church             Organization       @relation(fields: [churchId], references: [id])
  @@index([churchId, status])
  @@index([status, endDate])
  @@index([plan, status])
  @@map("church_subscription")
}

model UserSubscription {
  id                     String             @id @default(cuid())
  plan                   UserPlan
  status                 SubscriptionStatus @default(TRIAL)
  isPaid                 Boolean            @default(false)
  invoiceAmount          Float              @default(0)
  paidAmount             Float              @default(0)
  balAmount              Float              @default(0)
  features               String[]
  churchId               String?
  maxSmallGroupsLead     Int?               @default(0)
  currentSmallGroupsLead Int?               @default(0)
  maxEventsManage        Int?               @default(0)
  currentEventsManage    Int?               @default(0)
  startDate              DateTime
  endDate                DateTime
  isAutoRenew            Boolean            @default(true)
  paymentMethod          PaymentMethodType? @default(M_PESA)
  lastPaymentDate        DateTime?
  nextBillingDate        DateTime?
  canceledAt             DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  @@index([userId, status])
  @@index([status, endDate])
  @@index([plan, status])
  @@map("user_subscription")
}

// ============================================
// LOGGING AND PAYMENTS
// ============================================

model Log {
  id           String      @id @default(cuid())
  level        LogLevel
  message      String
  errorName    String?
  errorMessage String?
  errorStack   String?
  errorCode    String?
  metadata     Json?
  timestamp    DateTime    @default(now())
  source       LogSource
  environment  Environment
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  churchId     String
  church       Organization @relation(fields: [churchId], references: [id])
  @@index([level, timestamp])
  @@index([source, level, timestamp])
  @@index([environment, timestamp])
  @@map("log")
}

model Payment {
  id                String        @id @default(cuid())
  amount            Float
  date              DateTime
  method            PaymentMethod
  reference         String
  status            PaymentStatus @default(PENDING)
  description       String?
  relatedEntityType String
  relatedEntityId   String
  payerId           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  churchId          String
  church            Organization  @relation(fields: [churchId], references: [id])
  @@index([churchId, status])
  @@map("payment")
}

// ============================================
// REPORTS
// ============================================

model Report {
  id              String        @id @default(cuid())
  name            String
  type            ReportType
  description     String
  dateRange       DateRange     @default(LAST_30_DAYS)
  customStartDate DateTime?
  customEndDate   DateTime?
  format          ReportFormat  @default(PDF)
  includeCharts   Boolean       @default(true)
  includeComparisons Boolean    @default(false)
  departments     String[]
  status          ReportStatus  @default(GENERATING)
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  generatedAt     DateTime?
  downloadCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  churchId        String
  church          Organization  @relation(fields: [churchId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  reportData      ReportData?
  createdBy       String
  creator         User          @relation(fields: [createdBy], references: [id])
  @@index([churchId, branchId])
  @@index([churchId, status])
  @@index([churchId, type])
  @@index([createdBy])
  @@index([status, createdAt])
  @@index([generatedAt])
  @@map("report")
}

model ReportData {
  id               String            @id @default(cuid())
  totalRecords     Int               @default(0)
  startDate        DateTime
  endDate          DateTime
  generationTime   Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reportId         String            @unique
  report           Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  departmentCounts DepartmentCount[]
  @@map("report_data")
}

model DepartmentCount {
  id             String     @id @default(cuid())
  departmentId   String
  departmentName String
  count          Int
  reportDataId   String
  reportData     ReportData @relation(fields: [reportDataId], references: [id], onDelete: Cascade)
  @@map("department_count")
}

// ============================================
// MILESTONES
// ============================================

model Milestone {
  id                     String              @id @default(cuid())
  name                   String
  description            String
  category               MilestoneCategory
  points                 Int
  targetDate             DateTime
  completionDate         DateTime?
  requirements           String?
  isActive               Boolean             @default(true)
  order                  Int                 @default(0)
  level                  DiscipleLevel
  prerequisiteMilestones String[]
  completionCount        Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  churchId               String
  church                 Organization        @relation(fields: [churchId], references: [id])
  branchId               String?
  branch                 Branch?             @relation(fields: [branchId], references: [id])
  discipleProgress       DiscipleProgress[]
  milestoneProgress      MilestoneProgress[]
  @@index([churchId, branchId])
  @@index([churchId, category])
  @@index([churchId, level])
  @@index([churchId, isActive])
  @@index([category, order])
  @@index([level, order])
  @@map("milestone")
}

// ============================================
// MESSAGING
// ============================================

model MessageTemplate {
  id          String           @id @default(cuid())
  name        String
  type        MessageType
  category    TemplateCategory
  title       String
  content     String
  variables   String[]
  isActive    Boolean          @default(true)
  usageCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  churchId    String
  church      Organization     @relation(fields: [churchId], references: [id])
  createdBy   String
  creator     User             @relation(fields: [createdBy], references: [id])
  messages    Message[]
  @@unique([churchId, name])
  @@index([churchId, isActive])
  @@index([churchId, type, isActive])
  @@index([churchId, category, isActive])
  @@index([createdBy])
  @@map("message_template")
}

model Message {
  id            String                    @id @default(cuid())
  type          MessageType
  title         String
  content       String
  recipients    String[]
  scheduleType  ScheduleType              @default(NOW)
  scheduleDate  DateTime?
  scheduleTime  String?
  status        MessageStatus             @default(DRAFT)
  sentAt        DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  churchId      String
  church        Organization              @relation(fields: [churchId], references: [id])
  branchId      String?
  branch        Branch?                   @relation(fields: [branchId], references: [id])
  templateId    String?
  template      MessageTemplate?          @relation(fields: [templateId], references: [id])
  deliveryStats MessageDeliveryStats?
  createdBy     String
  creator       User                      @relation(fields: [createdBy], references: [id])
  @@index([churchId, branchId])
  @@index([churchId, status])
  @@index([churchId, type])
  @@index([scheduleDate, status])
  @@index([createdBy])
  @@map("message")
}

model MessageDeliveryStats {
  id        String   @id @default(cuid())
  total     Int      @default(0)
  sent      Int      @default(0)
  delivered Int      @default(0)
  failed    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@map("message_delivery_stats")
}

model MessageRecipient {
  id           String            @id @default(cuid())
  recipientId  String            @unique
  name         String
  description  String?
  type         RecipientType     @default(CUSTOM)
  targetModel  TargetModel
  targetId     String?
  memberCount  Int               @default(0)
  isActive     Boolean           @default(true)
  autoUpdate   Boolean           @default(true)
  lastUpdated  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  churchId     String
  church       Organization      @relation(fields: [churchId], references: [id])
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  criteria     RecipientCriteria?
  createdBy    String
  creator      User              @relation(fields: [createdBy], references: [id])
  @@unique([churchId, recipientId])
  @@index([churchId, isActive])
  @@index([churchId, type, isActive])
  @@index([branchId])
  @@index([targetModel, targetId])
  @@map("message_recipient")
}

model RecipientCriteria {
  id            String           @id @default(cuid())
  userStatus    String[]
  roles         String[]
  minAge        Int?
  maxAge        Int?
  gender        Gender?
  departmentIds String[]
  groupIds      String[]
  customQuery   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  recipientId   String           @unique
  recipient     MessageRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@map("recipient_criteria")
}

// ============================================
// DISCIPLESHIP
// ============================================

model Disciple {
  id                  String             @id @default(cuid())
  startDate           DateTime
  endDate             DateTime?
  currentLevel        DiscipleLevel
  status              DiscipleStatus     @default(ACTIVE)
  goals               String
  notes               String?
  progress            Int                @default(0)
  milestonesCompleted String[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  churchId            String
  church              Organization       @relation(fields: [churchId], references: [id])
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  memberId            String
  member              User               @relation("DiscipleMember", fields: [memberId], references: [id])
  mentorId            String
  mentor              User               @relation("DiscipleMentor", fields: [mentorId], references: [id])
  discipleProgress    DiscipleProgress[]
  @@index([churchId, branchId])
  @@index([churchId, memberId])
  @@index([churchId, mentorId])
  @@index([churchId, status])
  @@index([churchId, currentLevel])
  @@index([startDate])
  @@map("disciple")
}

model DiscipleProgress {
  id                 String              @id @default(cuid())
  date               DateTime
  topic              String
  status             String
  notes              String?
  isCompleted        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  discipleId         String
  disciple           Disciple            @relation(fields: [discipleId], references: [id])
  branchId           String?
  branch             Branch?             @relation(fields: [branchId], references: [id])
  milestones         Milestone[]
  milestoneProgress  MilestoneProgress[]
  @@map("disciple_progress")
}

model MilestoneProgress {
  id                 String           @id @default(cuid())
  milestoneId        String
  milestone          Milestone        @relation(fields: [milestoneId], references: [id])
  discipleProgressId String
  discipleProgress   DiscipleProgress @relation(fields: [discipleProgressId], references: [id])
  @@map("milestone_progress")
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

model Content {
  id           String          @id @default(cuid())
  title        String
  description  String
  type         ContentType
  category     ContentCategory
  tags         String[]
  status       ContentStatus   @default(DRAFT)
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  fileMimeType String?
  author       String?
  publishedAt  DateTime?
  viewCount    Int             @default(0)
  downloadCount Int            @default(0)
  isPublic     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  churchId     String
  church       Organization    @relation(fields: [churchId], references: [id])
  branchId     String?
  branch       Branch?         @relation(fields: [branchId], references: [id])
  @@index([churchId, type])
  @@map("content")
}