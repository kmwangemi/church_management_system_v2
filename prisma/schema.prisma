// Complete Prisma Schema for Church Management System
// Aligned with Better Auth Organization Plugin

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

