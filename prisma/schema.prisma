// ============================================
// BETTER AUTH MODELS (Augmented)
// ============================================

model User {
  id            String    @id @default(auto()) 
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  // CRITICAL: Relations to Organization via Member model
  members       Member[]
  invitations   Invitation[]
  // Extended fields for church management (Global User Data)
  phoneNumber            String?
  dateOfBirth            DateTime?
  gender                 Gender?
  occupation             String?
  maritalStatus          MaritalStatus?
  skills                 String[]
  notes                  String?
  // CRITICAL: Removed churchId and branchId - Membership is now defined by the 'Member' model.
  // Role system (Global Role - use Member.role for organizational role)
  isMember               Boolean              @default(false)
  role                   UserRole             @default(VISITOR) // For SuperAdmin/System roles
  isStaff                Boolean              @default(false)
  isVolunteer            Boolean              @default(false)
  // Address - normalized to separate model
  address                Address?
  // Emergency contact - normalized to separate model
  emergencyContact       EmergencyContact?
  // Role-specific details (Separate models are fine for normalization)
  memberDetails          MemberDetails?
  pastorDetails          PastorDetails?
  bishopDetails          BishopDetails?
  staffDetails           StaffDetails?
  volunteerDetails       VolunteerDetails?
  adminDetails           AdminDetails?
  visitorDetails         VisitorDetails?
  // Account status
  status                 AccountStatus        @default(ACTIVE)
  lastLogin              DateTime?
  // Security
  isPasswordUpdated      Boolean              @default(false)
  agreeToTerms           Boolean              @default(true)
  isDeleted              Boolean              @default(false)
  // Audit (Relations to itself)
  createdBy              String?              @id
  createdByUser          User?                @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCreated           User[]               @relation("UserCreatedBy")
  updatedBy              String?              @id
  updatedByUser          User?                @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersUpdated           User[]               @relation("UserUpdatedBy")
  // Relations to other CM models (Keep these)
  churchesCreated        Organization[]       @relation("ChurchCreator") // Links to Organization now
  offerings              Offering[]
  pledges                Pledge[]
  reports                Report[]
  messageTemplates       MessageTemplate[]
  messages               Message[]
  messageRecipients      MessageRecipient[]
  disciplesAsMember      Disciple[] @relation("DiscipleMember")
  disciplesAsMentor      Disciple[] @relation("DiscipleMentor")
  prayerRequestsSubmitted PrayerRequest[]     @relation("PrayerRequestSubmitter")
  userSubscriptions      UserSubscription[]
  departmentMemberships  DepartmentMember[]
  groupMemberships       GroupMember[]
  attendanceRecords      AttendanceRecord[]
  activitiesOrganized    GroupActivity[]
  goalsCreated           GroupGoal[]
  departmentGoalsCreated DepartmentGoal[]
  announcementsCreated   Announcement[]
  logsGenerated          Log[]
  branchesPastored       Branch[]             @relation("BranchPastor")
  attendancesTaken       Attendance[]
  expensesApproved       Expense[]
  departmentActivitiesOrganized DepartmentActivity[]
  departmentsLed         Department[]         @relation("DepartmentLeader")
  groupsLed              Group[]              @relation("GroupLeader")
  @@unique([email])
  @@index([role, status])
  @@index([isDeleted])
  @@map("user")
}

model Session {
  id                   String   @id @default(auto()) 
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String? // Used by Better Auth to track active church
  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) 
  accountId             String
  providerId            String
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) 
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  @@map("verification")
}

// CRITICAL: The Organization model is now your Church entity
model Organization {
  id          String       @id @default(auto()) 
  name        String       @map("churchName") // Remap 'name' to your domain language
  slug        String?
  logo        String?      @map("churchLogoUrl")
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  // ADD: Church-specific fields from your original Church model
  denomination     String
  email            String      @unique
  phoneNumber      String      @unique
  website          String?
  establishedDate  DateTime
  churchSize       String
  numberOfBranches Int         @default(1)
  description      String?
  isSuspended      Boolean     @default(false)
  isDeleted        Boolean     @default(false)
  // Relations
  address          Address? // 1:1 relation to Address
  // CRITICAL: Relations pointing to Organization
  createdBy        String      @id
  creator          User        @relation("ChurchCreator", fields: [createdBy], references: [id])
  branches         Branch[]
  departments      Department[]
  groups           Group[]
  events           Event[]
  offerings        Offering[]
  pledges          Pledge[]
  prayerRequests   PrayerRequest[]
  serviceSchedules ServiceSchedule[]
  activities       Activity[]
  assets           Asset[]
  announcements    Announcement[]
  attendances      Attendance[]
  subscription     ChurchSubscription?
  logs             Log[]
  payments         Payment[]
  reports          Report[]
  milestones       Milestone[]
  messageTemplates MessageTemplate[]
  messages         Message[]
  messageRecipients MessageRecipient[]
  disciples        Disciple[]
  content          Content[]
  updatedAt        DateTime    @updatedAt
  @@unique([slug])
  @@index([denomination])
  @@index([churchSize])
  @@index([isSuspended, isDeleted])
  @@map("organization") // CRITICAL: Must be mapped to "organization" for the plugin
}

model Member {
  id             String       @id @default(auto()) 
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @id
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // CRITICAL: This is the user's role *within the church* (e.g., ADMIN, PASTOR, MEMBER)
  role           ORGANIZATIONUserRole 
  createdAt      DateTime
  // ADD: Branch association for the member within the church
  branchId       String?      @id
  branch         Branch?      @relation("BranchMembers", fields: [branchId], references: [id])
  @@map("member")
}

model Invitation {
  id             String       @id @default(auto()) 
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String       @id
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  @@map("invitation")
}

// Normalized Address Model (used by multiple entities)
model Address {
  id        String   @id @default(auto()) 
  street    String?
  city      String?
  state     String?
  zipCode   String?
  country   String   @default("Kenya")
  // Relations - one address can belong to one entity
  userId    String?  @unique @id
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // CRITICAL: Pointing to Organization
  churchId  String?  @unique @id
  church    Organization?  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branchId  String?  @unique @id
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("address")
}

// Normalized Emergency Contact Model (No changes)
model EmergencyContact {
  id           String  @id @default(auto()) 
  fullName     String
  email        String?
  phoneNumber  String
  relationship String
  address      String?
  notes        String?
  // Relations
  userId       String  @unique @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("emergency_contact")
}

// ============================================
// USER ROLE-SPECIFIC DETAIL MODELS
// ============================================
model MemberDetails {
  id               String      @id @default(auto()) 
  memberId         String // Should ideally be related to the 'Member' model, but using userId is fine if 1:1 with User
  membershipDate   DateTime    @default(now())
  membershipStatus MembershipStatus @default(ACTIVE)
  departmentIds    String[]    @id
  groupIds         String[]    @id
  occupation       String?
  baptismDate      DateTime?
  joinedDate       DateTime    @default(now())
  userId           String      @unique @id
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@map("member_details")
}

