  departmentIds    String[]          @id
  groupIds         String[]          @id
  customQuery      String?           // JSON string if needed for complex queries
  recipientId      String            @unique @id
  recipient        MessageRecipient  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  @@map("recipient_criteria")
}

model Disciple {
  id                  String             @id @default(auto()) 
  churchId            String   @id
  church              Organization @relation(fields: [churchId], references: [id]) // CRITICAL: Organization
  branchId            String?            @id
  branch              Branch?            @relation(fields: [branchId], references: [id])
  memberId            String             @id
  member              User               @relation("DiscipleMember", fields: [memberId], references: [id])
  mentorId            String             @id
  mentor              User               @relation("DiscipleMentor", fields: [mentorId], references: [id])
  startDate           DateTime
  endDate             DateTime?
  currentLevel        DiscipleLevel
  status              DiscipleStatus     @default(ACTIVE)
  goals               String
  notes               String?
  progress            Int                @default(0)
  milestonesCompleted String[]           @id
  discipleProgress    DiscipleProgress[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  @@index([churchId, branchId])
  @@index([churchId, memberId])
  @@index([churchId, mentorId])
  @@index([churchId, status])
  @@index([churchId, currentLevel])
  @@index([startDate])
  @@map("disciple")
}

model DiscipleProgress {
  id             String   @id @default(auto()) 
  discipleId     String   @id
  disciple       Disciple @relation(fields: [discipleId], references: [id])
  branchId       String?  @id
  branch         Branch?  @relation(fields: [branchId], references: [id])
  date           DateTime
  topic          String
  status         String
  notes          String?
  milestones     Milestone[]
  milestoneProgress  MilestoneProgress[]
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("disciple_progress")
}

model MilestoneProgress {
  id                 String            @id @default(auto()) @id
  milestoneId        String            @id
  milestone          Milestone         @relation(fields: [milestoneId], references: [id])

  discipleProgressId String            @id
  discipleProgress   DiscipleProgress  @relation(fields: [discipleProgressId], references: [id])
}

model Content {
  id            String   @id @default(auto()) 
  churchId      String   @id
  church        Organization @relation(fields: [churchId], references: [id]) // CRITICAL: Organization
  branchId      String?  @id
  branch        Branch?  @relation(fields: [branchId], references: [id])
  title         String
  description   String
  type          ContentType
  category      ContentCategory
  tags          String[]
  status        ContentStatus  @default(DRAFT)
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  fileMimeType  String?
  author        String?
  publishedAt   DateTime?
  viewCount     Int            @default(0)
  downloadCount Int            @default(0)
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([churchId, type])
  @@map("content")
}