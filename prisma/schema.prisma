// ============================================
// SUBSCRIPTIONS
// ============================================

model OrganizationSubscription {
  id                 String             @id @default(cuid())
  plan               OrganizationPlan   @default(BASIC)
  status             SubscriptionStatus @default(TRIAL)
  isPaid             Boolean            @default(false)
  isActive           Boolean            @default(false)
  invoiceAmount      Float              @default(0)
  paidAmount         Float              @default(0)
  balAmount          Float              @default(0)
  maxUsers           Int?
  maxTeams           Int?               @default(1)
  maxSmallGroups     Int?
  currentUsers       Int                @default(0)
  currentTeams       Int                @default(0)
  currentSmallGroups Int                @default(0)
  features           String[]
  startDate          DateTime
  endDate            DateTime
  isAutoRenew        Boolean            @default(true)
  paymentMethod      PaymentMethodType? @default(M_PESA)
  lastPaymentDate    DateTime?
  nextBillingDate    DateTime?
  canceledAt         DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organizationId     String             @unique
  organization       Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([status, endDate])
  @@index([plan, status])
  @@map("organization_subscription")
}

model UserSubscription {
  id                     String             @id @default(cuid())
  plan                   UserPlan
  status                 SubscriptionStatus @default(TRIAL)
  isPaid                 Boolean            @default(false)
  invoiceAmount          Float              @default(0)
  paidAmount             Float              @default(0)
  balAmount              Float              @default(0)
  features               String[]
  churchId               String?
  maxSmallGroupsLead     Int?               @default(0)
  currentSmallGroupsLead Int?               @default(0)
  maxEventsManage        Int?               @default(0)
  currentEventsManage    Int?               @default(0)
  startDate              DateTime
  endDate                DateTime
  isAutoRenew            Boolean            @default(true)
  paymentMethod          PaymentMethodType? @default(M_PESA)
  lastPaymentDate        DateTime?
  nextBillingDate        DateTime?
  canceledAt             DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, endDate])
  @@index([plan, status])
  @@map("user_subscription")
}

// ============================================
// LOGGING
// ============================================

model Log {
  id             String        @id @default(cuid())
  level          LogLevel
  message        String
  errorName      String?
  errorMessage   String?
  errorStack     String?
  errorCode      String?
  metadata       Json?
  timestamp      DateTime      @default(now())
  source         LogSource
  environment    Environment
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String? // Made nullable to allow logs without org context
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([level, timestamp])
  @@index([source, level, timestamp])
  @@index([environment, timestamp])
  @@map("log")
}
