// ============================================
// BETTER AUTH MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Better Auth relations
  sessions      Session[]
  accounts      Account[]
  // Organization membership
  members       Member[]
  invitations   Invitation[]
  // Extended profile fields
  phoneNumber            String?
  dateOfBirth            DateTime?
  gender                 Gender?
  occupation             String?
  maritalStatus          MaritalStatus?
  skills                 String[]
  notes                  String?
  // Global role (SUPER_ADMIN or VISITOR)
  role                   UserRole             @default(VISITOR)
  status                 AccountStatus        @default(ACTIVE)
  lastLogin              DateTime?
  // Flags
  isMember               Boolean              @default(false)
  isStaff                Boolean              @default(false)
  isVolunteer            Boolean              @default(false)
  isPasswordUpdated      Boolean              @default(false)
  agreeToTerms           Boolean              @default(true)
  isDeleted              Boolean              @default(false)
  // Normalized relations
  address                Address?
  emergencyContact       EmergencyContact?
  // Role-specific details
  memberDetails          MemberDetails?
  pastorDetails          PastorDetails?
  bishopDetails          BishopDetails?
  staffDetails           StaffDetails?
  volunteerDetails       VolunteerDetails?
  adminDetails           AdminDetails?
  visitorDetails         VisitorDetails?
  // Self-referential relations
  createdBy              String?
  createdByUser          User?                @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCreated           User[]               @relation("UserCreatedBy")
  updatedBy              String?
  updatedByUser          User?                @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersUpdated           User[]               @relation("UserUpdatedBy")
  branchesPastored       Branch[]             @relation("BranchPastor")
  departmentsLed         Department[]         @relation("DepartmentLeader")
  groupsLed              Group[]              @relation("GroupLeader")
  // Activity relations
  offerings              Offering[]
  pledges                Pledge[]
  reports                Report[]
  messageTemplates       MessageTemplate[]
  messages               Message[]
  messageRecipients      MessageRecipient[]
  disciplesAsMember      Disciple[]           @relation("DiscipleMember")
  disciplesAsMentor      Disciple[]           @relation("DiscipleMentor")
  prayerRequestsSubmitted PrayerRequest[]     @relation("PrayerRequestSubmitter")
  userSubscriptions      UserSubscription[]
  departmentMemberships  DepartmentMember[]
  groupMemberships       GroupMember[]
  attendanceRecords      AttendanceRecord[]
  activitiesOrganized    GroupActivity[]
  goalsCreated           GroupGoal[]
  departmentGoalsCreated DepartmentGoal[]
  announcementsCreated   Announcement[]
  logsGenerated          Log[]
  attendancesTaken       Attendance[]
  expensesApproved       Expense[]
  departmentActivitiesOrganized DepartmentActivity[]
  @@index([email])
  @@index([role, status])
  @@index([isDeleted])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth uses this to track active organization
  activeOrganizationId String?
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@map("verification")
}

// ============================================
// ORGANIZATION (CHURCH) MODEL
// ============================================

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String      @unique
  logo        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  metadata    Json // flexible extras
  // Better Auth requires these relations
  members     Member[]
  invitations Invitation[]
  // Relations
  address          Address?
  branches         Branch[]
  departments      Department[]
  groups           Group[]
  events           Event[]
  offerings        Offering[]
  pledges          Pledge[]
  prayerRequests   PrayerRequest[]
  serviceSchedules ServiceSchedule[]
  activities       Activity[]
  assets           Asset[]
  announcements    Announcement[]
  attendances      Attendance[]
  subscription     ChurchSubscription?
  logs             Log[]
  payments         Payment[]
  reports          Report[]
  milestones       Milestone[]
  messageTemplates MessageTemplate[]
  messages         Message[]
  messageRecipients MessageRecipient[]
  disciples        Disciple[]
  content          Content[]
  @@map("organization")
}

// ============================================
// MEMBER MODEL
// ============================================

model Member {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Role within the organization
  role           ORGANIZATIONUserRole @default(MEMBER)
  createdAt      DateTime             @default(now())
  // Branch assignment within church
  branchId       String?
  branch         Branch?              @relation("BranchMembers", fields: [branchId], references: [id])
  // Composite unique constraint required by Better Auth
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([branchId])
  @@map("member")
}

// ============================================
// INVITATION MODEL
// ============================================

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  // Unique constraint for email per organization
  @@unique([organizationId, email])
  @@index([email])
  @@map("invitation")
}

// ============================================
// NORMALIZED MODELS
// ============================================

model Address {
  id        String        @id @default(cuid())
  street    String?
  city      String?
  state     String?
  zipCode   String?
  country   String        @default("Kenya")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String?       @unique
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId  String?       @unique
  church    Organization? @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branchId  String?       @unique
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@map("address")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  fullName     String
  email        String?
  phoneNumber  String
  relationship String
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("emergency_contact")
}

// ============================================
// USER ROLE-SPECIFIC DETAILS
// ============================================

model MemberDetails {
  id               String           @id @default(cuid())
  memberId         String
  membershipDate   DateTime         @default(now())
  membershipStatus MembershipStatus @default(ACTIVE)
  occupation       String?
  baptismDate      DateTime?
  joinedDate       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  departmentIds    String[]
  groupIds         String[]
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("member_details")
}

model PastorDetails {
  id                 String             @id @default(cuid())
  pastorId           String
  ordinationDate     DateTime?
  qualifications     String[]
  specializations    String[]
  sermonCount        Int                @default(0)
  counselingSessions Int                @default(0)
  biography          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignments        PastorAssignment[]
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("pastor_details")
}

model PastorAssignment {
  id               String        @id @default(cuid())
  position         String
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branchId         String?
  pastorDetailsId  String
  pastorDetails    PastorDetails @relation(fields: [pastorDetailsId], references: [id], onDelete: Cascade)
  @@map("pastor_assignment")
}

model BishopDetails {
  id               String   @id @default(cuid())
  bishopId         String
  appointmentDate  DateTime?
  jurisdictionArea String?
  qualifications   String[]
  achievements     String[]
  biography        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branchIds        String[]
  pastorIds        String[]
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("bishop_details")
}

model StaffDetails {
  id             String         @id @default(cuid())
  staffId        String
  jobTitle       String
  department     String
  startDate      DateTime
  endDate        DateTime?
  salary         Float?
  employmentType EmploymentType @default(CASUAL)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("staff_details")
}

model VolunteerDetails {
  id                   String                @id @default(cuid())
  volunteerId          String
  volunteerStatus      VolunteerStatus       @default(ACTIVE)
  hoursContributed     Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  departments          String[]
  availabilitySchedule AvailabilitySchedule?
  volunteerRoles       VolunteerRole[]
  backgroundCheck      BackgroundCheck?
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("volunteer_details")
