// ============================================
// BETTER AUTH MODELS
// ============================================

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Better Auth relations
  sessions          Session[]
  accounts          Account[]
  // Organization membership (church membership)
  members           Member[]
  invitations       Invitation[]
  // Extended profile fields
  phoneNumber       String?
  dateOfBirth       DateTime?
  gender            Gender?
  occupation        String?
  maritalStatus     MaritalStatus?
  skills            String[]
  notes             String?
  // Global role (SUPER_ADMIN, ADMIN or USER)
  globalRole        GlobalRole         @default(USER)
  status            AccountStatus      @default(ACTIVE)
  lastLogin         DateTime?
  // Flags
  isPasswordUpdated Boolean            @default(false)
  agreeToTerms      Boolean            @default(true)
  isDeleted         Boolean            @default(false)
  // Normalized relations
  address           Address?
  emergencyContact  EmergencyContact?
  // Role-specific details
  memberDetails     MemberDetails?
  pastorDetails     PastorDetails?
  bishopDetails     BishopDetails?
  staffDetails      StaffDetails?
  volunteerDetails  VolunteerDetails?
  adminDetails      AdminDetails?
  visitorDetails    VisitorDetails?
  // Self-referential relations
  createdBy         String?
  createdByUser     User?              @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCreated      User[]             @relation("UserCreatedBy")
  updatedBy         String?
  updatedByUser     User?              @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersUpdated      User[]             @relation("UserUpdatedBy")
  // Team leadership (for pastors/team leaders)
  // teamsPastored       Team[]               @relation("TeamPastor")
  // Department and Group leadership
  // departmentsLed         Department[]         @relation("DepartmentLeader")
  // groupsLed              Group[]              @relation("GroupLeader")
  // Activity relations
  // offerings              Offering[]
  // pledges                Pledge[]
  // reports                Report[]
  // messageTemplates       MessageTemplate[]
  // messages               Message[]
  // messageRecipients      MessageRecipient[]
  // disciplesAsMember      Disciple[]           @relation("DiscipleMember")
  // disciplesAsMentor      Disciple[]           @relation("DiscipleMentor")
  // prayerRequestsSubmitted PrayerRequest[]     @relation("PrayerRequestSubmitter")
  userSubscriptions UserSubscription[]
  // departmentMemberships  DepartmentMember[]
  // groupMemberships       GroupMember[]
  // attendanceRecords      AttendanceRecord[]
  // activitiesOrganized    GroupActivity[]
  // goalsCreated           GroupGoal[]
  // departmentGoalsCreated DepartmentGoal[]
  // announcementsCreated   Announcement[]
  logsGenerated     Log[]
  // attendancesTaken       Attendance[]
  // expensesApproved       Expense[]
  // departmentActivitiesOrganized DepartmentActivity[]
  teammembers       TeamMember[] // all teams/branches the member is in

  @@index([email])
  @@index([globalRole, status])
  @@index([isDeleted])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth uses this to track active organization (church)
  activeOrganizationId String? // Current active church
  activeTeamId         String? // Current active branch
  // Add this to track member role in session
  activeMemberRole     String[]  @default([]) // ✅ Changed to array with default empty array

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================
// ORGANIZATION (CHURCH) MODEL
// ============================================

model Organization {
  id               String                    @id @default(cuid())
  name             String
  slug             String                    @unique
  logo             String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  // Extended organization fields
  denomination     String?
  description      String?
  establishedDate  DateTime                  @default(now())
  email            String?
  phoneNumber      String?
  website          String?
  address          Address?
  churchSize       String?
  numberOfBranches Int?
  status           String?                   @default("Active")
  mission          String?
  vision           String?
  values           String[]
  isActive         Boolean                   @default(true)
  isSuspended      Boolean                   @default(false)
  isDeleted        Boolean                   @default(false)
  metadata         Json? // flexible extras - store church-specific info
  // Better Auth requires these relations
  members          Member[]
  invitations      Invitation[]
  teams            Team[] // Branches are teams in Better Auth
  // Relations
  // departments      Department[]
  // groups           Group[]
  // events           Event[]
  // offerings        Offering[]
  // pledges          Pledge[]
  // prayerRequests   PrayerRequest[]
  // serviceSchedules ServiceSchedule[]
  // activities       Activity[]
  // assets           Asset[]
  // announcements    Announcement[]
  // attendances      Attendance[]
  subscription     OrganizationSubscription?
  logs             Log[]
  // payments         Payment[]
  // reports          Report[]
  // milestones       Milestone[]
  // messageTemplates MessageTemplate[]
  // messages         Message[]
  // messageRecipients MessageRecipient[]
  // disciples        Disciple[]
  // content          Content[]

  @@map("organization")
}

// ============================================
// MEMBER MODEL (CHURCH MEMBERSHIP)
// ============================================

model Member {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole[] @default([MEMBER])
  // position within church
  position       String?            @default("member")
  createdAt      DateTime           @default(now())

  // Team (Branch) assignment within church
  // teamId         String?
  // team           Team?                @relation("TeamMembers", fields: [teamId], references: [id])
  // Composite unique constraint required by Better Auth
  // @@index([teamId])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

// ============================================
// INVITATION MODEL
// ============================================

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  // Optional team assignment for invitation
  teamId         String? // Invite to specific team/branch

  // Unique constraint for email per organization
  @@unique([organizationId, email])
  @@index([email])
  @@map("invitation")
}

// ============================================
// NORMALIZED MODELS
// ============================================

model Address {
  id             String        @id @default(cuid())
  street         String?
  city           String?
  state          String?
  zipCode        String?
  country        String        @default("Kenya")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?       @unique
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("address")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  fullName     String
  email        String?
  phoneNumber  String
  relationship String
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contact")
}

// ============================================
// USER ROLE-SPECIFIC DETAILS
// ============================================

model MemberDetails {
  id               String           @id @default(cuid())
  memberId         String
  membershipDate   DateTime         @default(now())
  membershipStatus MembershipStatus @default(ACTIVE)
  occupation       String?
  baptismDate      DateTime?
  joinedDate       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  departmentIds    String[]
  groupIds         String[]
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_details")
}

model PastorDetails {
  id                 String             @id @default(cuid())
  pastorId           String
  ordinationDate     DateTime?
  qualifications     String[]
  specializations    String[]
  sermonCount        Int                @default(0)
  counselingSessions Int                @default(0)
  biography          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignments        PastorAssignment[]
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pastor_details")
}

model PastorAssignment {
  id              String        @id @default(cuid())
  position        String
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  teamId          String? // Reference to branch/team
  pastorDetailsId String
  pastorDetails   PastorDetails @relation(fields: [pastorDetailsId], references: [id], onDelete: Cascade)

  @@map("pastor_assignment")
}

model BishopDetails {
  id               String    @id @default(cuid())
  bishopId         String
  appointmentDate  DateTime?
  jurisdictionArea String?
  qualifications   String[]
  achievements     String[]
  biography        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  teamIds          String[] // Team IDs the bishop oversees
  pastorIds        String[]
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bishop_details")
}

model StaffDetails {
  id             String         @id @default(cuid())
  staffId        String
  jobTitle       String
  department     String
  startDate      DateTime
  endDate        DateTime?
  salary         Float?
  employmentType EmploymentType @default(CASUAL)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_details")
}

model VolunteerDetails {
  id                   String                @id @default(cuid())
  volunteerId          String
  volunteerStatus      VolunteerStatus       @default(ACTIVE)
  hoursContributed     Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  departments          String[]
  availabilitySchedule AvailabilitySchedule?
  volunteerRoles       VolunteerRole[]
  backgroundCheck      BackgroundCheck?
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteer_details")
}

model AvailabilitySchedule {
  id                 String           @id @default(cuid())
  days               String[]
  timeSlots          String[]
  preferredTimes     String[]
  volunteerDetailsId String           @unique
  volunteerDetails   VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)

  @@map("availability_schedule")
}

model VolunteerRole {
  id                 String           @id @default(cuid())
  role               String
  department         String?
  startDate          DateTime         @default(now())
  endDate            DateTime?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  volunteerDetailsId String
  volunteerDetails   VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)

  @@map("volunteer_role")
}

model BackgroundCheck {
  id                 String           @id @default(cuid())
  completed          Boolean          @default(false)
  completedDate      DateTime?
  expiryDate         DateTime?
  clearanceLevel     ClearanceLevel?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  volunteerDetailsId String           @unique
  volunteerDetails   VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)

  @@map("background_check")
}

model AdminDetails {
  id            String           @id @default(cuid())
  adminId       String
  accessLevel   AdminAccessLevel @default(NATIONAL)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignedTeams String[] // Team IDs assigned to this admin
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_details")
}

model VisitorDetails {
  id                     String         @id @default(cuid())
  visitorId              String
  visitDate              DateTime       @default(now())
  howDidYouHear          HowDidYouHear  @default(OTHER)
  followUpStatus         FollowUpStatus @default(PENDING)
  followUpDate           DateTime?
  followUpNotes          String?
  interestedInMembership Boolean        @default(false)
  servicesAttended       String[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  invitedBy              String?
  userId                 String         @unique
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visitor_details")
}

model Team {
  id              String       @id @default(cuid())
  name            String
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?    @updatedAt
  teammembers     TeamMember[]
  address         Address?
  // Extended team fields
  email           String?
  phoneNumber     String?
  capacity        Int?
  memberCount     Int          @default(0)
  establishedDate DateTime?
  description     String?
  isActive        Boolean      @default(true)
  isDeleted       Boolean      @default(false)
  metadata        Json? // Store additional team info

  @@map("team")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime? @default(now())

  @@map("teamMember")
}

