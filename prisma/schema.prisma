model AvailabilitySchedule {
  id                  String           @id @default(cuid())
  days                String[]
  timeSlots           String[]
  preferredTimes      String[]
  volunteerDetailsId  String           @unique
  volunteerDetails    VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)
  @@map("availability_schedule")
}

model VolunteerRole {
  id                  String           @id @default(cuid())
  role                String
  department          String?
  startDate           DateTime         @default(now())
  endDate             DateTime?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  volunteerDetailsId  String
  volunteerDetails    VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)
