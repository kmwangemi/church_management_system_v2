// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER AUTH MODELS (Existing)
// ============================================

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  // Extended fields for church management
  phoneNumber            String?
  dateOfBirth            DateTime?
  gender                 Gender?
  occupation             String?
  maritalStatus          MaritalStatus?
  skills                 String[]
  notes                  String?
  // Church associations
  churchId               String?              @db.ObjectId
  church                 Church?              @relation("ChurchMembers", fields: [churchId], references: [id])
  branchId               String?              @db.ObjectId
  branch                 Branch?              @relation("BranchMembers", fields: [branchId], references: [id])
  // Role system
  isMember               Boolean              @default(false)
  role                   UserRole             @default(VISITOR)
  isStaff                Boolean              @default(false)
  isVolunteer            Boolean              @default(false)
  // Address - normalized to separate model
  address                Address?
  // Emergency contact - normalized to separate model
  emergencyContact       EmergencyContact?
  // Role-specific details (separate models for normalization)
  memberDetails          MemberDetails?
  pastorDetails          PastorDetails?
  bishopDetails          BishopDetails?
  staffDetails           StaffDetails?
  volunteerDetails       VolunteerDetails?
  adminDetails           AdminDetails?
  visitorDetails         VisitorDetails?
  // Account status
  status                 AccountStatus        @default(ACTIVE)
  lastLogin              DateTime?
  // Security
  isPasswordUpdated      Boolean              @default(false)
  agreeToTerms           Boolean              @default(true)
  isDeleted              Boolean              @default(false)
  // Audit
  createdBy              String?              @db.ObjectId
  createdByUser          User?                @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCreated           User[]               @relation("UserCreatedBy")
  updatedBy              String?              @db.ObjectId
  updatedByUser          User?                @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersUpdated           User[]               @relation("UserUpdatedBy")
  // Relations
  churchesCreated        Church[]             @relation("ChurchCreator")
  offerings              Offering[]
  pledges                Pledge[]
  prayerRequestsSubmitted PrayerRequest[]     @relation("PrayerRequestSubmitter")
  userSubscriptions      UserSubscription[]
  departmentMemberships  DepartmentMember[]
  groupMemberships       GroupMember[]
  attendanceRecords      AttendanceRecord[]
  activitiesOrganized    GroupActivity[]
  goalsCreated           GroupGoal[]
  departmentGoalsCreated DepartmentGoal[]
  announcementsCreated   Announcement[]
  logsGenerated          Log[]
  branchesPastored       Branch[]             @relation("BranchPastor")
  attendancesTaken       Attendance[]
  expensesApproved       Expense[]
  departmentActivitiesOrganized DepartmentActivity[]
  departmentsLed         Department[]         @relation("DepartmentLeader")
  groupsLed              Group[]              @relation("GroupLeader")

  @@unique([email])
  @@index([churchId, status])
  @@index([role, status])
  @@index([branchId])
  @@index([isDeleted])
  @@map("user")
}

model Session {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.ObjectId
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Organization {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String       @db.ObjectId
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ============================================
// CHURCH MANAGEMENT MODELS
// ============================================

// Normalized Address Model (used by multiple entities)
model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  street    String?
  city      String?
  state     String?
  zipCode   String?
  country   String   @default("Kenya")
  // Relations - one address can belong to one entity
  userId    String?  @unique @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId  String?  @unique @db.ObjectId
  church    Church?  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branchId  String?  @unique @db.ObjectId
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("address")
}

// Normalized Emergency Contact Model
model EmergencyContact {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  email        String?
  phoneNumber  String
  relationship String
  address      String?
  notes        String?
  // Relations
  userId       String  @unique @db.ObjectId
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("emergency_contact")
}

// ============================================
// USER ROLE-SPECIFIC DETAIL MODELS
// ============================================

model MemberDetails {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  memberId         String
  membershipDate   DateTime    @default(now())
  membershipStatus MembershipStatus @default(ACTIVE)
  departmentIds    String[]    @db.ObjectId
  groupIds         String[]    @db.ObjectId
  occupation       String?
  baptismDate      DateTime?
  joinedDate       DateTime    @default(now())
  userId           String      @unique @db.ObjectId
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("member_details")
}

model PastorDetails {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  pastorId         String
  ordinationDate   DateTime?
  qualifications   String[]
  specializations  String[]
  assignments      PastorAssignment[]
  sermonCount      Int                 @default(0)
  counselingSessions Int               @default(0)
  biography        String?
  userId           String              @unique @db.ObjectId
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("pastor_details")
}

model PastorAssignment {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  branchId         String?        @db.ObjectId
  position         String
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean        @default(true)
  pastorDetailsId  String         @db.ObjectId
  pastorDetails    PastorDetails  @relation(fields: [pastorDetailsId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("pastor_assignment")
}

model BishopDetails {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  bishopId         String
  appointmentDate  DateTime?
  jurisdictionArea String?
  branchIds        String[]       @db.ObjectId
  pastorIds        String[]       @db.ObjectId
  qualifications   String[]
  achievements     String[]
  biography        String?
  userId           String         @unique @db.ObjectId
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("bishop_details")
}

model StaffDetails {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  staffId        String
  jobTitle       String
  department     String
  startDate      DateTime
  endDate        DateTime?
  salary         Float?
  employmentType EmploymentType @default(CASUAL)
  isActive       Boolean        @default(true)
  userId         String         @unique @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("staff_details")
}

model VolunteerDetails {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  volunteerId          String
  volunteerStatus      VolunteerStatus     @default(ACTIVE)
  availabilitySchedule AvailabilitySchedule?
  departments          String[]            @db.ObjectId
  volunteerRoles       VolunteerRole[]
  backgroundCheck      BackgroundCheck?
  hoursContributed     Int                 @default(0)
  userId               String              @unique @db.ObjectId
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("volunteer_details")
}

model AvailabilitySchedule {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  days                String[]
  timeSlots           String[]
  preferredTimes      String[]
  volunteerDetailsId  String           @unique @db.ObjectId
  volunteerDetails    VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)
  
  @@map("availability_schedule")
}

model VolunteerRole {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  role                String
  department          String?
  startDate           DateTime         @default(now())
  endDate             DateTime?
  isActive            Boolean          @default(true)
  volunteerDetailsId  String           @db.ObjectId
  volunteerDetails    VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("volunteer_role")
}

model BackgroundCheck {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  completed           Boolean          @default(false)
  completedDate       DateTime?
  expiryDate          DateTime?
  clearanceLevel      ClearanceLevel?
  volunteerDetailsId  String           @unique @db.ObjectId
  volunteerDetails    VolunteerDetails @relation(fields: [volunteerDetailsId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("background_check")
}

model AdminDetails {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  adminId          String
  accessLevel      AdminAccessLevel @default(NATIONAL)
  assignedBranches String[]     @db.ObjectId
  userId           String       @unique @db.ObjectId
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("admin_details")
}

model VisitorDetails {
  id                      String         @id @default(auto()) @map("_id") @db.ObjectId
  visitorId               String
  visitDate               DateTime       @default(now())
  invitedBy               String?        @db.ObjectId
  howDidYouHear           HowDidYouHear  @default(OTHER)
  followUpStatus          FollowUpStatus @default(PENDING)
  followUpDate            DateTime?
  followUpNotes           String?
  interestedInMembership  Boolean        @default(false)
  servicesAttended        String[]
  userId                  String         @unique @db.ObjectId
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@map("visitor_details")
}

model Church {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  churchName       String
  denomination     String
  email            String      @unique
  phoneNumber      String      @unique
  website          String?
  establishedDate  DateTime
  churchLogoUrl    String?
  churchSize       String
  numberOfBranches Int         @default(1)
  description      String?
  isSuspended      Boolean     @default(false)
  isDeleted        Boolean     @default(false)
  // Address relationship (1:1)
  address          Address?
  // Relations
  createdBy        String      @db.ObjectId
  creator          User        @relation("ChurchCreator", fields: [createdBy], references: [id])
  members          User[]      @relation("ChurchMembers")
  branches         Branch[]
  departments      Department[]
  groups           Group[]
  events           Event[]
  offerings        Offering[]
  pledges          Pledge[]
  prayerRequests   PrayerRequest[]
  serviceSchedules ServiceSchedule[]
  activities       Activity[]
  assets           Asset[]
  announcements    Announcement[]
  attendances      Attendance[]
  subscription     ChurchSubscription?
  logs             Log[]
  payments         Payment[]
  reports          Report[]
  milestones       Milestone[]
  messageTemplates MessageTemplate[]
  messages         Message[]
  messageRecipients MessageRecipient[]
  disciples        Disciple[]
  content          Content[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([denomination])
  @@index([churchSize])
  @@index([isSuspended, isDeleted])
  @@map("church")
}

model Branch {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  churchId        String      @db.ObjectId
  church          Church      @relation(fields: [churchId], references: [id])
  branchName      String      @unique
  email           String?
  phoneNumber     String?
  capacity        Int
  members         Int         @default(0)
  establishedDate DateTime
  description     String?
  isActive        Boolean     @default(true)
  isDeleted       Boolean     @default(false)
  // Relations
  pastorId        String?     @db.ObjectId
  pastor          User?       @relation("BranchPastor", fields: [pastorId], references: [id])
  users           User[]      @relation("BranchMembers")
  serviceSchedules ServiceSchedule[]
  prayerRequests  PrayerRequest[]
  activities      Activity[]
  assets          Asset[]
  announcements   Announcement[]
  attendances     Attendance[]
  events          Event[]
  reports         Report[]
  milestones      Milestone[]
  disciples       Disciple[]
  discipleProgress DiscipleProgress[]
  content         Content[]
  messageRecipients MessageRecipient[]
  messages        Message[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([churchId, isActive])
  @@index([churchId, isDeleted])
  @@index([pastorId])
  @@map("branch")
}

model Department {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  churchId        String               @db.ObjectId
  church          Church               @relation(fields: [churchId], references: [id])
  branchId        String?              @db.ObjectId
  departmentName  String
  description     String
  location        String?
  category        DepartmentCategory
  establishedDate DateTime
  meetingDay      String[]
  meetingTime     String[]
  isActive        Boolean              @default(true)
  isDeleted       Boolean              @default(false)
  totalBudget     Float                @default(0)
  // Leadership
  leaderId        String?              @db.ObjectId
  leader          User?                @relation("DepartmentLeader", fields: [leaderId], references: [id])
  // Relations
  members      DepartmentMember[]
  budgetCategories BudgetCategory[]
  expenses     Expense[]
  activities   DepartmentActivity[]
  goals        DepartmentGoal[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([churchId])
  @@index([leaderId])
  @@map("department")
}

model DepartmentMember {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String       @db.ObjectId
  department   Department   @relation(fields: [departmentId], references: [id])
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id])
  role         MemberRole
  skills       String[]
  joinedDate   DateTime     @default(now())
  isActive     Boolean      @default(true)
  notes        String?

  @@map("department_member")
}

model BudgetCategory {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  departmentId    String         @db.ObjectId
  department      Department     @relation(fields: [departmentId], references: [id])
  category        ExpenseCategory
  allocatedAmount Float
  spentAmount     Float          @default(0)
  description     String?

  @@map("budget_category")
}

model Expense {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String          @db.ObjectId
  department   Department      @relation(fields: [departmentId], references: [id])
  category     ExpenseCategory
  amount       Float
  description  String
  date         DateTime
  reference    String?
  vendor       String?
  receiptUrl   String?
  approvedBy   String?         @db.ObjectId
  approver     User?           @relation(fields: [approvedBy], references: [id])
  createdAt    DateTime        @default(now())

  @@map("expense")
}

model DepartmentActivity {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String       @db.ObjectId
  department   Department   @relation(fields: [departmentId], references: [id])
  title        String
  description  String
  type         ActivityType
  date         DateTime
  startTime    String?
  endTime      String?
  location     String?
  participants String[]     @db.ObjectId
  notes        String?
  isCompleted  Boolean      @default(false)
  organizedBy  String       @db.ObjectId
  organizer    User         @relation(fields: [organizedBy], references: [id])
  createdAt    DateTime     @default(now())

  @@map("department_activity")
}

model DepartmentGoal {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id])
  title        String
  description  String
  targetDate   DateTime
  status       GoalStatus @default(PLANNED)
  priority     String
  category     String
  success      String
  assignee     String?    @db.ObjectId
  createdBy    String     @db.ObjectId
  creator      User       @relation(fields: [createdBy], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("department_goal")
}

model Group {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  churchId        String              @db.ObjectId
  church          Church              @relation(fields: [churchId], references: [id])
  groupName       String
  description     String?
  category        GroupCategory
  meetingDay      String[]
  meetingTime     String[]
  location        String?
  establishedDate DateTime
  capacity        Int
  isActive        Boolean             @default(true)
  // Statistics
  totalMembers    Int                 @default(0)
  activeMembers   Int                 @default(0)
  averageAttendance Float             @default(0)
  totalActivities Int                 @default(0)
  completedGoals  Int                 @default(0)
  // Relations
  leaderId        String?             @db.ObjectId
  leader          User?               @relation("GroupLeader", fields: [leaderId], references: [id])
  members         GroupMember[]
  activities      GroupActivity[]
  goals           GroupGoal[]
  attendanceSummaries AttendanceSummary[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([churchId])
  @@index([leaderId])
  @@index([category])
  @@map("group")
}

model GroupMember {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  groupId     String     @db.ObjectId
  group       Group      @relation(fields: [groupId], references: [id])
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id])
  role        GroupMemberRole
  joinedDate  DateTime   @default(now())
  isActive    Boolean    @default(true)
  notes       String?
  phone       String?
  email       String?

  @@map("group_member")
}

model GroupActivity {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId      String             @db.ObjectId
  group        Group              @relation(fields: [groupId], references: [id])
  title        String
  description  String
  type         GroupActivityType
  date         DateTime
  startTime    String?
  endTime      String?
  location     String?
  participants String[]           @db.ObjectId
  notes        String?
  isCompleted  Boolean            @default(false)
  organizedBy  String             @db.ObjectId
  organizer    User               @relation(fields: [organizedBy], references: [id])
  attendance   AttendanceRecord[]
  createdAt    DateTime           @default(now())

  @@map("group_activity")
}

model GroupGoal {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  groupId    String     @db.ObjectId
  group      Group      @relation(fields: [groupId], references: [id])
  title      String
  description String
  targetDate DateTime
  status     GroupGoalStatus @default(PLANNED)
  priority   String
  category   String
  success    String
  assignee   String?    @db.ObjectId
  createdBy  String     @db.ObjectId
  creator    User       @relation(fields: [createdBy], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("group_goal")
}

model AttendanceSummary {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId       String             @db.ObjectId
  group         Group              @relation(fields: [groupId], references: [id])
  date          DateTime
  totalExpected Int
  totalPresent  Int
  totalAbsent   Int
  totalLate     Int                @default(0)
  attendanceRate Float
  records       AttendanceRecord[]

  @@map("attendance_summary")
}

model AttendanceRecord {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  userId             String             @db.ObjectId
  user               User               @relation(fields: [userId], references: [id])
  status             AttendanceStatus
  arrivalTime        DateTime?
  notes              String?
  // Relations (one of these will be set)
  groupActivityId    String?            @db.ObjectId
  groupActivity      GroupActivity?     @relation(fields: [groupActivityId], references: [id])
  attendanceSummaryId String?           @db.ObjectId
  attendanceSummary  AttendanceSummary? @relation(fields: [attendanceSummaryId], references: [id])
  attendanceId       String?            @db.ObjectId
  attendance         Attendance?        @relation(fields: [attendanceId], references: [id])

  @@map("attendance_record")
}

model Event {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  churchId             String   @db.ObjectId
  church               Church   @relation(fields: [churchId], references: [id])
  branchId             String?  @db.ObjectId
  branch               Branch?  @relation(fields: [branchId], references: [id])
  title                String
  description          String
  type                 String
  startDate            DateTime
  endDate              DateTime
  startTime            String
  endTime              String
  location             String
  expectedAttendees    Int
  organizer            String
  maxAttendees         Int?
  requiresRegistration Boolean  @default(false)
  isRecurring          Boolean  @default(false)
  recurringPattern     String?
  registrationDeadline DateTime?
  notes                String?
  isPublic             Boolean  @default(true)
  status               EventStatus @default(ACTIVE)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([churchId, startDate])
  @@index([status])
  @@index([branchId])
  @@map("event")
}

model Offering {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  churchId  String        @db.ObjectId
  church    Church        @relation(fields: [churchId], references: [id])
  memberId  String        @db.ObjectId
  member    User          @relation(fields: [memberId], references: [id])
